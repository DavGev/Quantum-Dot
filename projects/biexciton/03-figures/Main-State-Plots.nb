Cell[CellGroupData[{

Cell["Radiative lifetime model from the reference paper", "Section",ExpressionUUID->"b7f6a12e-08b0-084d-8042-5ffcb33666a2"],

Cell["\<\
The reference gives tau_XX approximately tau_X/4 [Eq. (23)], \
\[LineSeparator]tau_X = 2 Pi epsilon_0 m c_light^3 hbar^2/(Sqrt[epsilon] e^2 \
E_exc^2 f) [Eq. (24)], and f = (E_P/E_exc) |M_X|^2 [Eq. (25)]. Here M_X is \
the normalized coincidence overlap stored by the production notebook. The \
GaAs parameters below are taken from Table 1 of the same paper.\
\>", "Text",
 CellChangeTimes->{
  3.9943966508582554`*^9},ExpressionUUID->"c8a9a814-672b-5441-98b0-\
0995df2e7295"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"SI", " ", "constants"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"vacuumPermittivity", " ", "=", " ", "8.8541878128*^-12"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"elementaryCharge", " ", "=", " ", "1.602176634*^-19"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"reducedPlanck", " ", "=", " ", "1.054571817*^-34"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"speedOfLight", " ", "=", " ", "2.99792458*^8"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"freeElectronMass", " ", "=", " ", "9.1093837015*^-31"}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "GaAs", " ", "parameters", " ", "from", " ", "Table", " ", "1", " ", "of",
      " ", "the", " ", "reference", " ", 
     RowBox[{"paper", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"gaasGapEV", " ", "=", " ", "1.5192"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gaasElectronMassRatio", " ", "=", " ", "0.067"}], ";"}], "\n",
   RowBox[{
    RowBox[{"gaasKaneEnergyEV", " ", "=", " ", "22.71"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gaasRelativePermittivity", " ", "=", " ", "12.8"}], ";"}], "\n",
   RowBox[{
    RowBox[{"gaasElectronMass", " ", "=", " ", 
     RowBox[{"gaasElectronMassRatio", " ", "freeElectronMass"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "excitonEnergyEV", ",", " ", "oscillatorStrengthX", ",", " ", "tauXps", ",",
       " ", "tauXXps", ",", " ", "tauXErrorPs", ",", " ", "tauXXErrorPs"}], 
     "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"excitonEnergyEV", "[", "row_Association", "]"}], " ", ":=", 
     "\n", "  ", 
     RowBox[{"gaasGapEV", " ", "+", " ", 
      RowBox[{
       RowBox[{"row", "[", "\"\<E_X (meV)\>\"", "]"}], "/", "1000."}]}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"oscillatorStrengthX", "[", "row_Association", "]"}], " ", ":=", 
     "\n", "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"gaasKaneEnergyEV", "/", 
        RowBox[{"excitonEnergyEV", "[", "row", "]"}]}], ")"}], " ", 
      RowBox[{"row", "[", "\"\<|M_X|^2\>\"", "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"tauXps", "[", "row_Association", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"10", "^", "12"}], " ", "*", "\n", "  ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
        "2", " ", "Pi", " ", "vacuumPermittivity", " ", "gaasElectronMass", " ", 
         RowBox[{"speedOfLight", "^", "3"}], " ", 
         RowBox[{"reducedPlanck", "^", "2"}]}], ")"}], "/", "\n", "   ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sqrt", "[", "gaasRelativePermittivity", "]"}], " ", 
         RowBox[{"elementaryCharge", "^", "2"}], "\n", "     ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"excitonEnergyEV", "[", "row", "]"}], " ", 
            "elementaryCharge"}], ")"}], "^", "2"}], " ", 
         RowBox[{"oscillatorStrengthX", "[", "row", "]"}]}], ")"}]}]}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"tauXXps", "[", "row_Association", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"tauXps", "[", "row", "]"}], "/", "4."}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"tauXErrorPs", "[", "row_Association", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"tauXps", "[", "row", "]"}], " ", 
      RowBox[{"Norm", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"row", "[", "\"\<E_X error (meV)\>\"", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"1000.", " ", 
            RowBox[{"excitonEnergyEV", "[", "row", "]"}]}], ")"}]}], ",", " ", 
         RowBox[{
          RowBox[{"row", "[", "\"\<|M_X|^2 error\>\"", "]"}], "/", 
          RowBox[{"row", "[", "\"\<|M_X|^2\>\"", "]"}]}]}], "}"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"tauXXErrorPs", "[", "row_Association", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"tauXErrorPs", "[", "row", "]"}], "/", "4."}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"plotRows", " ", "=", " ", 
     RowBox[{"Map", "[", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"#1", ",", "\n", "     ", 
          RowBox[{"<|", 
           RowBox[{
