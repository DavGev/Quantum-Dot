  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"labelX", "[", 
      RowBox[{"vals_", ",", " ", "x0_", ",", " ", "dx_", ",", " ", "tol_"}], 
      "]"}], " ", ":=", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
