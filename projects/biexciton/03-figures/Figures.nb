                    RowBox[{"[", "n", "]"}], "]"}]}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", " ", 
                    RowBox[{"vals", "[", 
                    RowBox[{"[", "n", "]"}], "]"}]}], "}"}]}], "}"}], "]"}], ",",
                "\n", "       ", 
