Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"worst", " ", "identity", " ", "spread", " ", "per", " ", 
    RowBox[{"run", " ", "--"}], " ", "quote", " ", "as", " ", "the", " ", 
    "relative", " ", "error", " ", "bar"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"worstSpread", "[", "res_", "]"}], " ", ":=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"res", "[", "\"\<check\>\"", "]"}], ",", "\n", "    ", 
