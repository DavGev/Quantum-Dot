Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"a", "-", 
     RowBox[{"scan", " ", "at", " ", "c"}]}], " ", "=", " ", 
    RowBox[{"6", " ", "nm"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"aScanGeoms", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"geometries", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"geometries", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], "]"}], " ", "<", 
         " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "6"}]}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"aNm", "[", "g_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "rB", " ", 
      RowBox[{"10", "^", "9"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"aData", "[", "label_", "]"}], " ", ":=", " ", 
     RowBox[{"Sort", "@", 
      RowBox[{"Select", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"aNm", "[", "#", "]"}], ",", " ", 
            RowBox[{"val", "[", 
             RowBox[{"label", ",", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], " ", "&"}], 
         " ", "/@", " ", "aScanGeoms"}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"NumericQ", "[", 
          RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "&"}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"figF3aScan", " ", "=", " ", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"aData", " ", "/@", " ", 
       RowBox[{"{", 
