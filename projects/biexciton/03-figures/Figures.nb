                    RowBox[{"[", "n", "]"}], "]"}]}], "}"}]}], "]"}]}], "}"}],
              ",", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{"n", ",", " ", 
               RowBox[{"Length", "[", "levels", "]"}]}], "}"}]}], "]"}], 
