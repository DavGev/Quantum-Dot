            RowBox[{
             RowBox[{
              RowBox[{"vals", "[", 
               RowBox[{"[", "n", "]"}], "]"}], " ", "-", " ", "prev"}], " ", "<",
              " ", "tol"}], ",", " ", 
            RowBox[{"tog", " ", "=", " ", 
             RowBox[{"1", " ", "-", " ", "tog"}]}], ",", " ", 
            RowBox[{"tog", " ", "=", " ", "0"}]}], "]"}], ";", "\n", "    ", 
          RowBox[{"prev", " ", "=", " ", 
           RowBox[{"vals", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], ";", " ", 
          RowBox[{"x0", " ", "+", " ", 
           RowBox[{"tog", " ", "dx"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", 
           RowBox[{"Length", "[", "vals", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"levelColumn", "[", 
      RowBox[{"levels_", ",", " ", "title_", ",", " ", "x0_"}], "]"}], " ", ":=",
      "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
