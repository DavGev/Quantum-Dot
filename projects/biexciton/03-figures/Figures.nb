 RowBox[{
  RowBox[{
   RowBox[{"transData", "[", 
    RowBox[{"l1_", ",", " ", "l2_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sort", "@", 
    RowBox[{"Select", "[", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"aa", " ", "=", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
            RowBox[{"cc", " ", "=", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"cNm", "[", "#", "]"}], ",", " ", 
            RowBox[{"dif", "[", 
             RowBox[{
              RowBox[{"val", "[", 
               RowBox[{"l1", ",", " ", "aa", ",", " ", "cc"}], "]"}], ",", 
              " ", 
              RowBox[{"val", "[", 
               RowBox[{"l2", ",", " ", "aa", ",", " ", "cc"}], "]"}]}], 
             "]"}]}], "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
       "cScanGeoms"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"NumericQ", "[", 
        RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "&"}]}], "]"}]}]}], 
  ";"}], "\n", 
