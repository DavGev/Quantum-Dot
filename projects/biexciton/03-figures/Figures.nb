            RowBox[{"Max", "[", "vals", "]"}], " ", "-", " ", 
            RowBox[{"Min", "[", "vals", "]"}], " ", "+", " ", 
            "$MachineEpsilon"}], ")"}]}]}], ";", "\n", "   ", 
        RowBox[{"xs", " ", "=", " ", 
