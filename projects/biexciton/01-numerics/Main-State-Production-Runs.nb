Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"energyKeysRy", " ", "=", " ", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{"\"\<E_X^0 (Ry)\>\"", ",", " ", "\"\<Delta E_X (Ry)\>\"", ",", 
      " ", "\"\<E_X (Ry)\>\"", ",", "\n", "   ", "\"\<E_XX^0 (Ry)\>\"", ",", 
      " ", "\"\<Delta E_XX (Ry)\>\"", ",", " ", "\"\<E_XX (Ry)\>\"", ",", 
      "\n", "   ", "\"\<E_bind = 2 E_X - E_XX (Ry)\>\"", ",", 
      " ", "\"\<E_XX - E_X (Ry)\>\""}], "\n", "   ", "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "mainToMeV", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mainToMeV", "[", "row_Association", "]"}], " ", ":=", " ", 
    RowBox[{"Association", " ", "@", " ", 
     RowBox[{"KeyValueMap", "[", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"energyKeysRy", ",", " ", "#1"}], "]"}], ",", "\n", 
          "      ", 
          RowBox[{
           RowBox[{"StringReplace", "[", 
            RowBox[{"#1", ",", " ", 
             RowBox[{"\"\<(Ry)\>\"", " ", "->", " ", "\"\<(meV)\>\""}]}], 
            "]"}], " ", "->", "\n", "       ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumericQ", "[", "#2", "]"}], ",", " ", 
             RowBox[{"#2", " ", "ER2meV"}], ",", " ", "#2"}], "]"}]}], ",", 
          "\n", "      ", 
          RowBox[{"#1", " ", "->", " ", "#2"}]}], "]"}], " ", "&"}], ",", 
       "\n", "   ", "row"}], "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"summaryRowsMeV", " ", "=", " ", 
   RowBox[{"mainToMeV", " ", "/@", " ", "summaryRowsRy"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", "summaryRowsMeV", "]"}]}], "Input",
 CellChangeTimes->{{3.994266634477379*^9, 
  3.994266634477379*^9}},ExpressionUUID->"b776efc7-e1e2-c740-89bd-\
8e127d558047"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Export", "[", 
