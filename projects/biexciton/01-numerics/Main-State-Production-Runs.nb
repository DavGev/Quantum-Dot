Notebook[{

Cell[CellGroupData[{
Cell["Main-State Production Runs", "Title",ExpressionUUID->"065e0c52-f09b-1b47-ad35-d87fa09c932e"],

Cell[TextData[{
 "This notebook runs only the ground exciton X00 and the main (ground) \
biexciton XX0000 at the seven requested geometries. Lengths a and c are in \
effective Bohr radii. Energies are in effective Rydberg and exclude the band \
gap. Each geometry is checkpointed after the exciton and again after the \
biexciton, so an interrupted campaign can be resumed safely. The final \
summary contains the zeroth-order energies, correlation corrections, \
corrected energies, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "bind"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b2a6a9ec-6e8a-b244-8514-3b6f552c04dd"],
 " = 2 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "X"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c8a6a15-fe54-ab49-89fa-5ced12a3ed31"],
 " - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "XX"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "88169709-9970-c547-8dfa-7398d03b9c8c"],
 ", and the normalized bright-exciton coincidence overlap ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "X"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fb4e6d3d-7bfe-2c40-8bd6-d918f6ad4ef5"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SqrtBox[
     SubscriptBox["N", "X"]]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0fdf27b7-99b1-0b4d-9bb8-647f7998b96e"],
 " together with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["M", "X"], 
    SuperscriptBox["|", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "71b808a9-5f56-4949-b5ed-be6c2df5de14"],
 "."
}], "Text",
 CellChangeTimes->{{3.994266651754059*^9, 3.9942666742779083`*^9}, {
  3.994266749756233*^9, 
  3.99426681532703*^9}},ExpressionUUID->"9265796a-68ab-294a-9c8c-\
e399d8e0cccc"],

