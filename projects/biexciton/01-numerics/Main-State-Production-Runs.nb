Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "mainValue", ",", " ", "mainDifference", ",", " ", "mainSummaryRow"}], 
    "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mainValue", "[", 
     RowBox[{"assoc_", ",", " ", "key_"}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"AssociationQ", "[", "assoc", "]"}], ",", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{"assoc", ",", " ", "key", ",", " ", 
        RowBox[{"Missing", "[", "\"\<NotRun\>\"", "]"}]}], "]"}], ",", " ", 
      RowBox[{"Missing", "[", "\"\<NotRun\>\"", "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mainDifference", "[", 
     RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"NumericQ", "[", "x", "]"}], " ", "&&", " ", 
       RowBox[{"NumericQ", "[", "y", "]"}]}], ",", " ", 
      RowBox[{"x", " ", "-", " ", "y"}], ",", " ", 
      RowBox[{"Missing", "[", "\"\<NotRun\>\"", "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mainSummaryRow", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aa_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"cc_", "?", "NumericQ"}]}], "}"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"mainStage", "[", 
          RowBox[{"aa", ",", " ", "cc", ",", " ", "\"\<X\>\""}], "]"}]}], ",",
         " ", 
        RowBox[{"xx", " ", "=", " ", 
         RowBox[{"mainStage", "[", 
          RowBox[{"aa", ",", " ", "cc", ",", " ", "\"\<XX\>\""}], "]"}]}], ",",
         " ", "ex", ",", " ", "exx"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"ex", " ", "=", " ", 
        RowBox[{"mainValue", "[", 
         RowBox[{"x", ",", " ", "\"\<total\>\""}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"exx", " ", "=", " ", 
        RowBox[{"mainValue", "[", 
         RowBox[{"xx", ",", " ", "\"\<total\>\""}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<a/rB\>\"", " ", "->", " ", "aa"}], ",", "\n", "    ", 
         RowBox[{"\"\<c/rB\>\"", " ", "->", " ", "cc"}], ",", "\n", "    ", 
         RowBox[{"\"\<E_X^0 (Ry)\>\"", " ", "->", " ", 
          RowBox[{"mainValue", "[", 
           RowBox[{"x", ",", " ", "\"\<singleParticle\>\""}], "]"}]}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<Delta E_X (Ry)\>\"", " ", "->", " ", 
          RowBox[{"mainValue", "[", 
           RowBox[{"x", ",", " ", "\"\<correction\>\""}], "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<E_X (Ry)\>\"", " ", "->", " ", "ex"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<E_XX^0 (Ry)\>\"", " ", "->", " ", 
          RowBox[{"mainValue", "[", 
           RowBox[{"xx", ",", " ", "\"\<singleParticle\>\""}], "]"}]}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<Delta E_XX (Ry)\>\"", " ", "->", " ", 
          RowBox[{"mainValue", "[", 
           RowBox[{"xx", ",", " ", "\"\<correction\>\""}], "]"}]}], ",", "\n",
          "    ", 
         RowBox[{"\"\<E_XX (Ry)\>\"", " ", "->", " ", "exx"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<E_bind = 2 E_X - E_XX (Ry)\>\"", " ", "->", "\n", 
          "      ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", "ex", "]"}], " ", "&&", " ", 
             RowBox[{"NumericQ", "[", "exx", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"2", " ", "ex"}], " ", "-", " ", "exx"}], ",", " ", 
            RowBox[{"Missing", "[", "\"\<NotRun\>\"", "]"}]}], "]"}]}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<E_XX - E_X (Ry)\>\"", " ", "->", " ", 
          RowBox[{"mainDifference", "[", 
           RowBox[{"exx", ",", " ", "ex"}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<N_X\>\"", " ", "->", " ", 
          RowBox[{"mainValue", "[", 
