          RowBox[{"mainValue", "[", 
           RowBox[{"x", ",", " ", "\"\<overlap M_X\>\""}], "]"}]}], ",", "\n",
          "    ", 
         RowBox[{"\"\<|M_X|^2\>\"", " ", "->", " ", 
          RowBox[{"mainValue", "[", 
           RowBox[{"x", ",", " ", "\"\<oscillator factor |M_X|^2\>\""}], 
           "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<X diagnostic max\>\"", " ", "->", " ", 
          RowBox[{"mainValue", "[", 
           RowBox[{"x", ",", " ", "\"\<diagnosticMax\>\""}], "]"}]}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<XX diagnostic max\>\"", " ", "->", " ", 
          RowBox[{"mainValue", "[", 
           RowBox[{"xx", ",", " ", "\"\<diagnosticMax\>\""}], "]"}]}]}], 
        "|>"}]}]}], "\n", "  ", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"summaryRowsRy", " ", "=", " ", 
   RowBox[{"mainSummaryRow", " ", "/@", " ", "geometries"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", "summaryRowsRy", "]"}]}], "Input",
 CellChangeTimes->{{3.9942666344357147`*^9, 
  3.9942666344357147`*^9}},ExpressionUUID->"ef1aa016-a625-4f4d-bede-\
