Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Requested", " ", 
      RowBox[{"order", ":", " ", 
       RowBox[{"c", " ", "scan", " ", "at", " ", "a"}]}]}], "=", "5"}], ",", 
    " ", 
    RowBox[{
     RowBox[{"then", " ", "a", " ", "scan", " ", "at", " ", "c"}], "=", 
     "1."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"geometries", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"{", "\n", "   ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "0.5"}], "}"}], ",", "\n", "   ", 
