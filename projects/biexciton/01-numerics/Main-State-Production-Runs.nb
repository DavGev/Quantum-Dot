        RowBox[{"{", 
         RowBox[{"10", ",", " ", "1"}], "}"}]}], "\n", "   ", "}"}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"groundState", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";"}], "\n", "\n", 
