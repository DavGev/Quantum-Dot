Cell[CellGroupData[{

Cell["Ground-state production runners", "Section",ExpressionUUID->"63e7d4bf-8fb2-5a45-8a95-368a0cc89c75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "configureGroundExciton", ",", " ", "configureGroundBiexciton", ",", "\n",
      "  ", "runGroundExciton", ",", " ", "runGroundBiexciton", ",", " ", 
     "runMainGeometry"}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"configureGroundExciton", "[", "]"}], " ", ":=", " ", 
    RowBox[{"(", "\n", "  ", 
     RowBox[{
      RowBox[{"exElectronState", " ", "=", " ", "groundState"}], ";", "\n", 
      "  ", 
      RowBox[{"exHoleState", " ", "=", " ", "groundState"}], ";"}], "\n", 
     "  ", ")"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"configureGroundBiexciton", "[", "]"}], " ", ":=", " ", 
   RowBox[{"(", "\n", "  ", 
    RowBox[{
     RowBox[{"bxElectronStates", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"groundState", ",", " ", "groundState"}], "}"}]}], ";", "\n", 
     "  ", 
     RowBox[{"bxHoleStates", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"groundState", ",", " ", "groundState"}], "}"}]}], ";", "\n", 
     "  ", 
     RowBox[{"bxEtaE", " ", "=", " ", "1"}], ";", "\n", "  ", 
     RowBox[{"bxEtaH", " ", "=", " ", "1"}], ";"}], "\n", "  ", ")"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9942665993655643`*^9, 3.9942665993655643`*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"1ac508a4-8d9a-be47-a6d9-47748541d311"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"runGroundExciton", "[", 
    RowBox[{
     RowBox[{"aa_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"cc_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "cached", ",", " ", "opt", ",", " ", "alpha", ",", " ", "energy", ",", 
       " ", "check", ",", " ", "norm", ",", " ", "result"}], "}"}], ",", "\n",
      "  ", 
     RowBox[{
      RowBox[{"cached", " ", "=", " ", 
       RowBox[{"mainStage", "[", 
        RowBox[{"aa", ",", " ", "cc", ",", " ", "\"\<X\>\""}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"AssociationQ", "[", "cached", "]"}], ",", " ", 
        RowBox[{"Return", "[", "cached", "]"}]}], "]"}], ";", "\n", "\n", 
      "  ", 
      RowBox[{"configureGroundExciton", "[", "]"}], ";", "\n", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<X00: minimizing at (a,c) = \>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"aa", ",", " ", "cc"}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"exMaxPoints", " ", "=", " ", "mainExMinPoints"}], "}"}], ",",
         "\n", "   ", 
        RowBox[{"minimizeExciton", "[", 
         RowBox[{
         "aa", ",", " ", "cc", ",", " ", "mainMaxIterations", ",", " ", 
          "Automatic"}], "]"}]}], "\n", "   ", "]"}], ";", "\n", "  ", 
      RowBox[{"opt", " ", "=", " ", 
       RowBox[{"exOptimum", "[", "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"AssociationQ", "[", "opt", "]"}]}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Exciton minimization did not produce an optimum at \
\>\"", ",", " ", 
           RowBox[{"{", 
            RowBox[{"aa", ",", " ", "cc"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "\n", "   ", "]"}], ";",
       "\n", "  ", 
      RowBox[{"alpha", " ", "=", " ", 
       RowBox[{"First", "[", 
        RowBox[{"opt", "[", "\"\<params\>\"", "]"}], "]"}]}], ";", "\n", "\n",
       "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<X00: final energy and identity stamp at (a,c) = \>\"", ",",
         " ", 
        RowBox[{"{", 
         RowBox[{"aa", ",", " ", "cc"}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"exMaxPoints", " ", "=", " ", "mainExFinalPoints"}], ",", 
          "\n", "    ", 
          RowBox[{
          "exPrecisionGoal", " ", "=", " ", "mainFinalPrecisionGoal"}]}], 
         "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"energy", " ", "=", " ", 
          RowBox[{"totalEnergyExciton", "[", 
           RowBox[{"aa", ",", " ", "cc", ",", " ", "alpha"}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"check", " ", "=", " ", 
          RowBox[{"exQuadratureCheck", "[", 
           RowBox[{"aa", ",", " ", "cc", ",", " ", "alpha"}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"norm", " ", "=", " ", 
          RowBox[{
           RowBox[{"check", "[", "\"\<normSwap\>\"", "]"}], 
           "[", "\"\<config\>\"", "]"}]}], ";"}]}], "\n", "   ", "]"}], ";", 
      "\n", "\n", "  ", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"energy", ",", "\n", "    ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<state\>\"", " ", "->", " ", "\"\<X00\>\""}], ",", 
           "\n", "      ", 
           RowBox[{"\"\<alpha\>\"", " ", "->", " ", "alpha"}], ",", "\n", 
           "      ", 
