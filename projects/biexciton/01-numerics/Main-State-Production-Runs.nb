Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"runMainGeometry", "[", 
    RowBox[{
     RowBox[{"aa_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"cc_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "xx"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<=== Main-state production geometry \>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"aa", ",", " ", "cc"}], "}"}], ",", " ", "\"\< ===\>\""}], 
       "]"}], ";", "\n", "  ", 
      RowBox[{"x", " ", "=", " ", 
       RowBox[{"runGroundExciton", "[", 
        RowBox[{"aa", ",", " ", "cc"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"x", " ", "===", " ", "$Failed"}], ",", " ", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"xx", " ", "=", " ", 
       RowBox[{"runGroundBiexciton", "[", 
        RowBox[{"aa", ",", " ", "cc"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"xx", " ", "===", " ", "$Failed"}], ",", " ", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<geometry\>\"", " ", "->", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<a\>\"", " ", "->", " ", "aa"}], ",", " ", 
           RowBox[{"\"\<c\>\"", " ", "->", " ", "cc"}]}], "|>"}]}], ",", " ", 
        RowBox[{"\"\<X\>\"", " ", "->", " ", "x"}], ",", " ", 
        RowBox[{"\"\<XX\>\"", " ", "->", " ", "xx"}]}], "|>"}]}]}], "\n", 
    "  ", "]"}]}], ";"}]], "Input",
