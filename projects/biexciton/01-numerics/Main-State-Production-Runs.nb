Cell[CellGroupData[{

Cell["Separate, resumable result store", "Section",ExpressionUUID->"f22f8480-fffc-a548-a011-576f7b6c3936"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "mainKey", ",", " ", "mainStage", ",", " ", "mainSave", ",", " ", 
     "mainStoreStage", ",", " ", "mainDiagnosticMax"}], "]"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"mainResultFile", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"dir", ",", " ", "\"\<main-state-production-results.wxf\>\""}], 
     "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mainRawStore", " ", "=", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", "mainResultFile", "]"}], ",", "\n", "   ", 
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"Import", "[", 
          RowBox[{"mainResultFile", ",", " ", "\"\<WXF\>\""}], "]"}], ",", 
         " ", "$Failed"}], "]"}], "]"}], ",", "\n", "   ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<schemaVersion\>\"", " ", "->", " ", "1"}], ",", " ", 
        RowBox[{"\"\<runs\>\"", " ", "->", " ", 
         RowBox[{"<|", "|>"}]}]}], "|>"}]}], "\n", "   ", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"!", " ", 
       RowBox[{"AssociationQ", "[", "mainRawStore", "]"}]}], " ", "||", "\n", 
      "   ", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{"mainRawStore", ",", " ", "\"\<schemaVersion\>\"", ",", " ", 
         RowBox[{"Missing", "[", "]"}]}], "]"}], " ", "=!=", " ", "1"}], " ", 
      "||", "\n", "   ", 
      RowBox[{"!", " ", 
       RowBox[{"AssociationQ", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"mainRawStore", ",", " ", "\"\<runs\>\"", ",", " ", 
          RowBox[{"Missing", "[", "]"}]}], "]"}], "]"}]}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<The result store is unreadable or has an unsupported \
schema: \>\"", ",", " ", "mainResultFile"}], "]"}], ";", "\n", "  ", 
      RowBox[{"Abort", "[", "]"}]}]}], "\n", "  ", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mainResults", " ", "=", " ", 
    RowBox[{"mainRawStore", "[", "\"\<runs\>\"", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mainKey", "[", 
     RowBox[{
      RowBox[{"aa_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"cc_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"StringRiffle", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{"#", ",", " ", "InputForm"}], "]"}], " ", "&"}], " ", "/@", 
       " ", 
       RowBox[{"N", "[", 
        RowBox[{"{", 
         RowBox[{"aa", ",", " ", "cc"}], "}"}], "]"}]}], ",", 
      " ", "\"\<|\>\""}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mainStage", "[", 
     RowBox[{
      RowBox[{"aa_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"cc_", "?", "NumericQ"}], ",", " ", "stage_String"}], "]"}], 
    " ", ":=", "\n", "  ", 
    RowBox[{"Lookup", "[", 
     RowBox[{
      RowBox[{"Lookup", "[", 
       RowBox[{"mainResults", ",", " ", 
        RowBox[{"mainKey", "[", 
         RowBox[{"aa", ",", " ", "cc"}], "]"}], ",", " ", 
        RowBox[{"<|", "|>"}]}], "]"}], ",", " ", "stage", ",", " ", 
      RowBox[{"Missing", "[", "\"\<NotRun\>\"", "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mainSave", "[", "]"}], " ", ":=", " ", 
    RowBox[{"Export", "[", 
     RowBox[{"mainResultFile", ",", "\n", "   ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<schemaVersion\>\"", " ", "->", " ", "1"}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<updated\>\"", " ", "->", " ", 
         RowBox[{"DateString", "[", "\"\<ISODateTime\>\"", "]"}]}], ",", "\n",
         "     ", 
        RowBox[{"\"\<runs\>\"", " ", "->", " ", "mainResults"}]}], "|>"}], ",",
       " ", "\"\<WXF\>\""}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mainStoreStage", "[", 
     RowBox[{
      RowBox[{"aa_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"cc_", "?", "NumericQ"}], ",", " ", "stage_String", ",", " ", 
      "value_Association"}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"key", " ", "=", " ", 
         RowBox[{"mainKey", "[", 
          RowBox[{"aa", ",", " ", "cc"}], "]"}]}], ",", " ", "row"}], "}"}], ",",
       "\n", "   ", 
      RowBox[{
       RowBox[{"row", " ", "=", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"mainResults", ",", " ", "key", ",", " ", 
          RowBox[{"<|", "|>"}]}], "]"}]}], ";", "\n", "   ", 
       RowBox[{
        RowBox[{"mainResults", "[", "key", "]"}], " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{"row", ",", "\n", "     ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<geometry\>\"", " ", "->", " ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<a\>\"", " ", "->", " ", "aa"}], ",", " ", 
               RowBox[{"\"\<c\>\"", " ", "->", " ", "cc"}]}], "|>"}]}], ",", 
            " ", 
            RowBox[{"stage", " ", "->", " ", "value"}]}], "|>"}]}], "]"}]}], ";",
        "\n", "   ", 
       RowBox[{"mainSave", "[", "]"}], ";", "\n", "   ", "value"}]}], "\n", 
     "   ", "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Includes", " ", "the", " ", "absolute", " ", "norm", 
    RowBox[{"(", 
     RowBox[{"alpha", "=", "0"}], ")"}], " ", "error", " ", "for", " ", "X", " ",
     "and", " ", "all", " ", "relative", " ", "identity", "\n", "   ", 
    "spreads", " ", "for", " ", "X", " ", "or", " ", 
    RowBox[{"XX", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mainDiagnosticMax", "[", "check_Association", "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "values", "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"values", " ", "=", " ", 
       RowBox[{"Join", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"check", ",", " ", 
           RowBox[{
            RowBox[{"HoldPattern", "[", 
             RowBox[{"\"\<relSpread\>\"", " ", "->", " ", 
              RowBox[{"s_", "?", "NumericQ"}]}], "]"}], " ", ":>", " ", "s"}],
            ",", " ", "Infinity"}], "]"}], ",", "\n", "    ", 
         RowBox[{"Cases", "[", 
          RowBox[{"check", ",", " ", 
           RowBox[{
            RowBox[{"HoldPattern", "[", 
             RowBox[{"\"\<error\>\"", " ", "->", " ", 
              RowBox[{"s_", "?", "NumericQ"}]}], "]"}], " ", ":>", " ", "s"}],
            ",", " ", "Infinity"}], "]"}]}], "\n", "    ", "]"}]}], ";", "\n",
       "  ", 
      RowBox[{"Max", "[", 
       RowBox[{"Prepend", "[", 
        RowBox[{"values", ",", " ", "0."}], "]"}], "]"}]}]}], "\n", "  ", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9942665993655643`*^9, 3.9942665993655643`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"d05a010d-295f-8a4f-98f2-e17dc213cd83"]
