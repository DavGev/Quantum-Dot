Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"runGroundBiexciton", "[", 
    RowBox[{
     RowBox[{"aa_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"cc_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "cached", ",", " ", "opt", ",", " ", "params", ",", " ", "energy", ",", 
       " ", "check", ",", " ", "result"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"cached", " ", "=", " ", 
       RowBox[{"mainStage", "[", 
        RowBox[{"aa", ",", " ", "cc", ",", " ", "\"\<XX\>\""}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"AssociationQ", "[", "cached", "]"}], ",", " ", 
        RowBox[{"Return", "[", "cached", "]"}]}], "]"}], ";", "\n", "\n", 
      "  ", 
      RowBox[{"configureGroundBiexciton", "[", "]"}], ";", "\n", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<XX0000: minimizing at (a,c) = \>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"aa", ",", " ", "cc"}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"bxMaxPoints", " ", "=", " ", "mainBxMinPoints"}], ",", " ", 
          RowBox[{"bxPrecisionGoal", " ", "=", " ", "2"}]}], "}"}], ",", "\n",
         "   ", 
        RowBox[{"minimizeBiexciton", "[", 
         RowBox[{
         "aa", ",", " ", "cc", ",", " ", "mainMaxIterations", ",", " ", 
          "Automatic"}], "]"}]}], "\n", "   ", "]"}], ";", "\n", "  ", 
      RowBox[{"opt", " ", "=", " ", 
       RowBox[{"bxOptimum", "[", "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"AssociationQ", "[", "opt", "]"}]}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Biexciton minimization did not produce an optimum at \
\>\"", ",", " ", 
           RowBox[{"{", 
            RowBox[{"aa", ",", " ", "cc"}], "}"}]}], "]"}], ";", "\n", "   ", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "\n", "   ", "]"}], ";",
       "\n", "  ", 
      RowBox[{"params", " ", "=", " ", 
       RowBox[{"opt", "[", "\"\<params\>\"", "]"}]}], ";", "\n", "\n", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<XX0000: final energy and identity stamp at (a,c) = \>\"", 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"aa", ",", " ", "cc"}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"bxMaxPoints", " ", "=", " ", "mainBxFinalPoints"}], ",", 
          "\n", "    ", 
          RowBox[{
          "bxPrecisionGoal", " ", "=", " ", "mainFinalPrecisionGoal"}]}], 
         "}"}], ",", "\n", "   ", 
        RowBox[{
         RowBox[{"energy", " ", "=", " ", 
          RowBox[{"totalEnergyBiexciton", "[", 
           RowBox[{"aa", ",", " ", "cc", ",", " ", 
            RowBox[{"Sequence", " ", "@@", " ", "params"}]}], "]"}]}], ";", 
         "\n", "   ", 
         RowBox[{"check", " ", "=", " ", 
          RowBox[{"bxQuadratureCheckAll", "[", 
           RowBox[{"aa", ",", " ", "cc", ",", " ", 
            RowBox[{"Sequence", " ", "@@", " ", "params"}]}], "]"}]}], 
         ";"}]}], "\n", "   ", "]"}], ";", "\n", "\n", "  ", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"energy", ",", "\n", "    ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<state\>\"", " ", "->", " ", "\"\<XX0000\>\""}], ",", 
           "\n", "      ", 
           RowBox[{"\"\<params\>\"", " ", "->", " ", "params"}], ",", "\n", 
           "      ", 
           RowBox[{"\"\<evaluations\>\"", " ", "->", " ", 
            RowBox[{"opt", "[", "\"\<evaluations\>\"", "]"}]}], ",", "\n", 
           "      ", 
           RowBox[{"\"\<check\>\"", " ", "->", " ", "check"}], ",", "\n", 
           "      ", 
           RowBox[{"\"\<diagnosticMax\>\"", " ", "->", " ", 
            RowBox[{"mainDiagnosticMax", "[", "check", "]"}]}], ",", "\n", 
           "      ", 
           
           RowBox[{"\"\<minMaxPoints\>\"", " ", "->", " ", 
            "mainBxMinPoints"}], ",", "\n", "      ", 
           
           RowBox[{"\"\<finalMaxPoints\>\"", " ", "->", " ", 
            "mainBxFinalPoints"}], ",", "\n", "      ", 
           RowBox[{"\"\<completed\>\"", " ", "->", " ", 
            RowBox[{"DateString", "[", "\"\<ISODateTime\>\"", "]"}]}]}], 
          "|>"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"mainStoreStage", "[", 
       RowBox[{
       "aa", ",", " ", "cc", ",", " ", "\"\<XX\>\"", ",", " ", "result"}], 
       "]"}]}]}], "\n", "  ", "]"}]}], ";"}]], "Input",
