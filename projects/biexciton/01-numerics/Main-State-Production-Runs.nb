         RowBox[{"3", ",", " ", "1"}], "}"}], ",", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"7", ",", " ", "1"}], "}"}], ",", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"10", ",", " ", "1"}], "}"}]}], "\n", "   ", "}"}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"groundState", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Validated", " ", "production", " ", "protocol", " ", "from", " ", "the", 
     " ", "Computational", " ", "Design", " ", 
     RowBox[{"Log", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"mainExMinPoints", " ", "=", " ", 
     RowBox[{"2", "*", 
      RowBox[{"10", "^", "5"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mainExFinalPoints", " ", "=", " ", 
     RowBox[{"10", "^", "6"}]}], ";"}], "\n", 
   RowBox[{
