Cell[CellGroupData[{
Cell["Fully Unreduced Main-State Benchmark: (a,c) = (5,1)", "Title",ExpressionUUID->"0c3692ac-fb87-ea40-82a1-7cf944428744"],

Cell["\<\
This notebook evaluates the stored X and XX optima without any \
particle-exchange or angular reduction. Every particle has its own azimuth on \
[0,2 Pi], the XX norm is G^2 (P+Q)^2, all six Coulomb terms are retained, and \
all four XX kinetic contributions are evaluated explicitly. No minimization \
is performed and no production file is modified. Each integral is timed and \
checkpointed independently, so an interrupted calculation resumes from the \
first unfinished integral.\
\>", "Text",ExpressionUUID->"c1a6cb8a-ffe6-ec4f-b71d-9653e16f4851"],

Cell[CellGroupData[{

Cell["Load definitions", "Section",ExpressionUUID->"42b72223-6a56-f648-95c1-fb70ce2c4f3e"],

