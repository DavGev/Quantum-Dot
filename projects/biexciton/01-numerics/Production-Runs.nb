4111c9275376"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "eta", " ", "fine", " ", "structure", " ", "of", " ", "XX0101", " ", "at", 
    " ", "the", " ", "base", " ", "geometry"}], " ", "*)"}], "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "get", "}"}], ",", "\n", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"get", "[", "l_", "]"}], " ", ":=", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"Lookup", "[", 
           RowBox[{"prodResults", ",", " ", 
            RowBox[{"prodKey", "[", 
             RowBox[{"l", ",", " ", 
              RowBox[{"Sequence", " ", "@@", " ", 
               RowBox[{"geometries", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], "]"}]}], "}"}], ",",
         "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"AssociationQ", "[", "r", "]"}], ",", " ", 
          RowBox[{"r", "[", "\"\<total\>\"", "]"}], ",", " ", 
          RowBox[{"Missing", "[", "\"\<NotRun\>\"", "]"}]}], "]"}]}], "]"}]}],
      ";", "\n", " ", 
     RowBox[{"Dataset", "[", 
      RowBox[{"<|", 
