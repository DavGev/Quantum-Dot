Cell[CellGroupData[{

Cell["Final verification", "Section",ExpressionUUID->"2f0cf60d-f783-5f47-b083-239bfa59103d"],

Cell["\<\
Only a refinement point that beats its accepted center at the search budget \
needs a new 2,000,000-point evaluation. Already evaluated centers are reused \
automatically. The cell returns the final decisions for all geometries.\
\>", "Text",ExpressionUUID->"d71094b3-1ee1-d94c-a364-b65be143c99d"],

